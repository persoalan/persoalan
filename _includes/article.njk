
<!DOCTYPE html>
<html lang="ms">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>{{ title }} | Persoalan.com</title>
  <meta name="description" content="{{ description }}">

  <style>
    body {
      margin: 0;
      background: #f5f7fa;
      color: #102238;
      font-family: Arial, sans-serif;
      line-height: 1.8;
    }

    header {
      background: #102238;
      padding: 22px;
      text-align: center;
    }

    header a {
      color: white;
      text-decoration: none;
      font-size: 25px;
      font-weight: bold;
    }

    main {
      max-width: 780px;
      margin: 45px auto;
      padding: 35px;
      background: white;
      border-radius: 14px;
    }

    h1 {
      line-height: 1.3;
      font-size: 36px;
    }

    .category {
      color: #0e9488;
      font-weight: bold;
    }

    article img {
      max-width: 100%;
      height: auto;
    }

    footer {
      text-align: center;
      padding: 30px;
      color: #64748b;
    }

    @media (max-width: 600px) {
      main {
        margin: 15px;
        padding: 22px;
      }

      h1 {
        font-size: 28px;
      }
    }
  </style>
</head>

<body>
  <header>
    <a href="/">Persoalan.com</a>
  </header>

  <main>
    <div class="category">{{ category }}</div>

    <h1>{{ title }}</h1>

    <p>{{ description }}</p>

    {% if image %}
      <img src="{{ image }}" alt="{{ title }}" style="max-width:100%">
    {% endif %}

    <hr>

    <article>
      {{ content | safe }}
    </article>

    <p><a href="/">← Kembali ke halaman utama</a></p>
  </main>

  <footer>
    © Persoalan.com
  </footer>
</body>
</html>
